+@pytest.mark.requires_internet
+def test_failed_build_keeps_previous_set(hatch, temp_dir, helpers):
+    project_name = "My.App"
+
+    with temp_dir.as_cwd():
+        result = hatch("new", project_name)
+        assert result.exit_code == 0, result.output
